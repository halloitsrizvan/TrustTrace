generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum ItemType {
  LOST
  FOUND
}

enum ItemStatus {
  OPEN
  MATCHED
  CLAIM_PENDING
  RETURNED
  CLOSED
  EXPIRED
}

enum ItemCategory {
  ID_CARD
  PHONE
  BOOK
  GADGET
  WALLET
  KEYS
  BAG
  OTHER
}

enum EmbeddingStatus {
  READY
  PENDING
  FAILED
}

enum ClaimStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
  EXPIRED
  COLLECTED
}

enum TipStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  EXPIRED
}

enum WalletEntryType {
  CREDIT
  DEBIT
}

enum WalletEntryReason {
  TIP_RECEIVED
  WITHDRAWAL
  REFUND
}

enum Badge {
  FIRST_RETURN
  CAMPUS_HERO
  GUARDIAN
  GRATEFUL_SOUL
  GENEROUS
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(STUDENT)
  trustScore    Int            @default(50)
  karma         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         Item[]
  claims        Claim[]        @relation("ClaimantClaims")
  decisions     Claim[]        @relation("AdminDecisions")
  notifications Notification[]
  auditLogs     AuditLog[]
  tipsGiven     Tip[]          @relation("TipsGiven")
  tipsReceived  Tip[]          @relation("TipsReceived")
  walletEntries WalletEntry[]
  badges        UserBadge[]
  karmaEvents   KarmaEvent[]
}

model Item {
  id                String                      @id @default(uuid()) @db.Uuid
  type              ItemType
  status            ItemStatus                  @default(OPEN)
  category          ItemCategory
  title             String
  publicDescription String
  zone              String
  eventTag          String?
  occurredAt        DateTime
  imageUrl          String?
  reporterId        String                      @db.Uuid
  holdLocation      String?
  embeddingStatus   EmbeddingStatus             @default(PENDING)
  publicEmbedding   Unsupported("vector(768)")?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  reporter          User                        @relation(fields: [reporterId], references: [id])
  private           ItemPrivate?
  lostMatches       Match[]                     @relation("LostMatches")
  foundMatches      Match[]                     @relation("FoundMatches")
  foundClaims       Claim[]                     @relation("FoundClaims")
  lostClaims        Claim[]                     @relation("LostClaims")

  @@index([type, status, category, zone, createdAt])
}

model ItemPrivate {
  itemId           String                      @id @db.Uuid
  privateDetails   String?
  privateImageUrl  String?
  privateEmbedding Unsupported("vector(768)")?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  item             Item                        @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Match {
  id          String   @id @default(uuid()) @db.Uuid
  lostItemId  String   @db.Uuid
  foundItemId String   @db.Uuid
  score       Float
  breakdown   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lostItem    Item     @relation("LostMatches", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem   Item     @relation("FoundMatches", fields: [foundItemId], references: [id], onDelete: Cascade)

  @@unique([lostItemId, foundItemId])
  @@index([lostItemId])
  @@index([foundItemId])
}

model Claim {
  id             String      @id @default(uuid()) @db.Uuid
  foundItemId    String      @db.Uuid
  lostItemId     String?     @db.Uuid
  claimantId     String      @db.Uuid
  status         ClaimStatus @default(PENDING)
  prompts        Json
  answers        Json?
  proofScore     Float       @default(0)
  trustScore     Int         @default(0)
  breakdown      Json
  attemptNo      Int         @default(1)
  startedAt      DateTime    @default(now())
  submittedAt    DateTime?
  tokenHash      String?
  tokenExpiresAt DateTime?
  decidedBy      String?     @db.Uuid
  decisionNote   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  foundItem      Item        @relation("FoundClaims", fields: [foundItemId], references: [id])
  lostItem       Item?       @relation("LostClaims", fields: [lostItemId], references: [id])
  claimant       User        @relation("ClaimantClaims", fields: [claimantId], references: [id])
  decider        User?       @relation("AdminDecisions", fields: [decidedBy], references: [id])
  tip            Tip?

  @@index([foundItemId, status])
  @@index([claimantId])
}

model Tip {
  id                String    @id @default(uuid()) @db.Uuid
  claimId           String    @unique @db.Uuid
  tipperId          String    @db.Uuid
  finderId          String    @db.Uuid
  amountMinor       Int
  currency          String    @default("INR")
  status            TipStatus @default(PENDING)
  message           String?
  anonymous         Boolean   @default(false)
  provider          String
  providerOrderId   String?   @unique
  providerPaymentId String?   @unique
  idempotencyKey    String    @unique
  createdAt         DateTime  @default(now())
  succeededAt       DateTime?
  claim             Claim     @relation(fields: [claimId], references: [id])
  tipper            User      @relation("TipsGiven", fields: [tipperId], references: [id])
  finder            User      @relation("TipsReceived", fields: [finderId], references: [id])

  @@index([finderId, status])
  @@index([tipperId])
}

model WalletEntry {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  type        WalletEntryType
  amountMinor Int
  reason      WalletEntryReason
  refId       String
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id])

  @@unique([reason, refId])
  @@index([userId])
}

model UserBadge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  badge     Badge
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, badge])
}

model KarmaEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  delta     Int
  reason    String
  refId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, reason, refId])
  @@index([userId])
  @@index([refId])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String
  meta      Json
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([entity, entityId, createdAt])
}
