NODE_ENV=development
DATABASE_URL=postgresql://trusttrace:trusttrace@localhost:5432/trusttrace
DIRECT_URL=postgresql://trusttrace:trusttrace@localhost:5432/trusttrace
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=1d
CORS_ORIGINS=http://localhost:3001
PORT=3000

# Mock embeddings keep the test build deterministic and require no external API.
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004
VISION_MODEL=gemini-2.0-flash
EMBEDDING_DIM=768

# Required by upload signing. Replace these to exercise real uploads.
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-key
CLOUDINARY_API_SECRET=test-secret

PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
