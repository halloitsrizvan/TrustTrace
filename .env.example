# Copy to .env beside compose.yaml to override these test defaults.
POSTGRES_DB=trusttrace
POSTGRES_USER=trusttrace
POSTGRES_PASSWORD=trusttrace
DATABASE_PORT=5432
SERVER_PORT=3000
CLIENT_PORT=3001
JWT_SECRET=testing-only-secret-change-before-production

# Real Cloudinary credentials are needed only when testing uploads.
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-key
CLOUDINARY_API_SECRET=test-secret

NEXT_PUBLIC_MOCK_PAYMENT=1
NEXT_PUBLIC_IMAGE_HOST=res.cloudinary.com
